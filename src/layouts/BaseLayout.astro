---
/**
 * The page shell. Every route renders through here, so head/meta discipline lives in exactly
 * one place — a marketing site that gets its canonical or its OG tags subtly wrong on one page
 * has no way of noticing.
 *
 * Zero client JS by default (ADR 0011 §1): nothing in this shell hydrates. Islands are opted
 * into per component, never inherited from the layout.
 */
import SiteFooter from '@/components/SiteFooter.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import { ICON_VERSION, NOINDEX, SITE_DESCRIPTION, SITE_NAME } from '@/consts'
import { url } from '@/lib/url'
import '@/styles/global.css'

interface Props {
  /** Page title WITHOUT the site name — the suffix is added here so it can never be doubled. */
  title: string
  description?: string
  /** Set false on legal/utility pages that should not compete in search. */
  index?: boolean
}

const { title, description = SITE_DESCRIPTION, index = true } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
const fullTitle = `${title} · ${SITE_NAME}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!index || NOINDEX) && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* One light theme by design (ADR 0012 §1) — light reads as *audited*, which is the right
        association for a product that posts entries to real books. Declared so form controls,
        scrollbars and the address bar match instead of flashing a dark UA default. */}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fafaf9" />

    {/* THE ?v= IS LOAD-BEARING, not decoration. A browser's favicon store is separate from its
        HTTP cache: it ignores `cache-control` (GitHub serves this one at max-age=600) and keys
        icons by URL, effectively forever. The mark here changed twice — placeholder equals sign,
        then the dome — and tabs opened before those changes kept showing the old glyph with no
        amount of reloading, because the URL never moved. Bump this whenever the icon changes. */}
    <link rel="icon" href={url(`/favicon.svg?v=${ICON_VERSION}`)} type="image/svg+xml" />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
  </head>

  <body class="min-h-svh">
    <a
      href="#main"
      class="border-hairline-strong bg-surface rounded-sm sr-only border px-4 py-2 text-sm focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
