---
/**
 * The supplied Credere navy wordmark. The web asset is a lossless crop of
 * `credere navy.png`, removing only the transparent canvas around the artwork.
 */
import { url } from '@/lib/url'

interface Props {
  href?: string
  class?: string
  /** `lg` in the header; `md` in the footer and other compact placements. */
  size?: 'md' | 'lg'
}

const { href, class: className = '', size = 'md' } = Astro.props
const Tag = href ? 'a' : 'div'
const imageSize = size === 'lg' ? 'h-8' : 'h-7'
---

<Tag
  {...href ? { href } : {}}
  data-wordmark
  class={`inline-flex items-center ${className}`}
  aria-label={href ? 'Credere — home' : undefined}
>
  <img
    src={url('/credere-wordmark.png')}
    alt="Credere"
    width="920"
    height="260"
    class:list={['w-auto object-contain', imageSize]}
  />
</Tag>
