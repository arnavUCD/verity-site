1v-3.914l-.14-.21v-.105l1.122-.084v1.451c.127-.301.414-.469.82-.469.576 0 .919.365.919 1.073v2.258h.001Zm-2.664-6.846c0 1.263.112 1.648.421 1.648.385 0 .455-.554.455-1.662 0-1.073-.077-1.606-.449-1.606-.315 0-.427.379-.427 1.62Zm7.041 1.487.14.211v.104h-1.262V11.6l.14-.211V8.787c0-.252-.084-.407-.281-.407-.244 0-.441.219-.441.638v2.371l.14.211v.104h-1.262V11.6l.14-.211V8.787c0-.252-.084-.407-.28-.407-.245 0-.442.219-.442.638v2.371l.141.211v.104h-1.263V11.6l.14-.211V8.535l-.14-.169v-.104l1.01-.12h.084l.028.393c.119-.309.414-.477.814-.477.427 0 .708.21.834.589.105-.365.435-.589.856-.589.553 0 .904.365.904 1.072v2.259Zm-1.311 4.644c0 .609-.393 1.114-1.339 1.114-.245 0-.575-.028-1.087-.119v-1.304h.287l.091.281c.224.715.441.982.785.982.323 0 .533-.232.533-.59 0-.294-.147-.497-.497-.687l-.603-.323c-.385-.21-.596-.539-.596-.946 0-.638.499-1.024 1.325-1.024.239 0 .547.034.884.105v1.024h-.287l-.148-.373c-.168-.449-.329-.595-.595-.595-.287 0-.456.168-.456.449 0 .238.141.399.484.595l.595.337c.406.232.624.561.624 1.074Zm4.538-4.644.14.211v.104h-1.073l-.048-.407c-.112.309-.407.491-.786.491-.561 0-.911-.35-.911-.926 0-.561.315-.932 1.283-1.311l.413-.16v-.526c0-.463-.084-.652-.343-.652-.211 0-.329.113-.533.624l-.231.575h-.317V8.27c.415-.127.828-.211 1.185-.211.792 0 1.221.379 1.221 1.066v2.264Zm-.982-.589V9.587l-.133.056c-.413.168-.567.547-.567 1.101 0 .414.098.653.329.653.23 0 .371-.225.371-.597Zm4.586.8v.104h-1.263V11.6l.141-.211V8.864c0-.302-.091-.484-.309-.484-.26 0-.449.219-.449.646v2.363l.14.211v.104h-1.262V11.6l.14-.211V8.535l-.14-.169v-.104l1.01-.12h.084l.028.393c.119-.309.407-.477.82-.477.575 0 .918.365.918 1.072v2.259L24 11.6Z',
  },
]

/** Stations, in scene coordinates. The camera pans past them in order. */
const STATIONS = [
  { x: 1780, label: 'Ingest', caption: 'Read once, never twice' },
  { x: 2280, label: 'Match', caption: 'Matched only on proof' },
  { x: 2800, label: 'Classify', caption: 'Duplicate, overpayment, or clean' },
  { x: 3300, label: 'Post', caption: 'Posted back to your books' },
]

/** The ledger — invoice rows in the customer's books. */
const ROWS = [
  { y: 210, ref: 'INV-1042' },
  { y: 268, ref: 'INV-1043' },
  { y: 326, ref: 'INV-1051' },
  { y: 384, ref: 'INV-1067' },
  { y: 442, ref: 'INV-1074' },
]

/** Payments on the rail. `row` is the ledger row it attributes to; null is the exception. */
const CHIPS = [
  { id: 'a', ref: 'INV-1042', amt: '$48,500.00', tag: 'duplicate', row: 0, x: 1940 },
  { id: 'b', ref: 'INV-1051', amt: '$12,000.00', tag: 'normal_payment', row: 2, x: 1640 },
  { id: 'c', ref: 'CHECK 8842', amt: '$9,150.00', tag: 'unmatchable', row: null, x: 1340 },
  { id: 'd', ref: 'INV-1074', amt: '$6,400.00', tag: 'overpayment', row: 4, x: 1040 },
]

const RAIL_Y = 620
const LEDGER_X = 3560
const ROW_W = 320
---

{/* The negative margin pulls the stage up UNDER the sticky header, so the film is genuinely
    full-bleed and the header floats on it. The copy adds the same height back as padding so it
    never sits beneath the nav. BOTH must track the header's height — it is 4.5rem in
    SiteHeader.astro, and if these two drift the hero copy slides under the bar. */}
<section data-film class="relative -mt-[4.5rem]">
  <div data-stage class="relative flex h-svh flex-col overflow-hidden">
    {/* preserveAspectRatio is xMIN, not xMid: the scene is nearly three viewports wide and the
        camera pans it, so it must be anchored to its LEFT edge. Centring it starts the film
        looking at the MIDDLE of the pipeline — stations on screen before the feed they process,
        and the narration wall off past the left edge where nobody ever sees it. */}
    <svg
      data-scene
      viewBox="0 0 4200 900"
      preserveAspectRatio="xMinYMid slice"
      fill="none"
      class="absolute inset-0 h-full w-full"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="film-beam" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="var(--scene-accent)" stop-opacity="0"></stop>
          <stop offset="50%" stop-color="var(--scene-accent)" stop-opacity="0.55"></stop>
          <stop offset="100%" stop-color="var(--scene-accent)" stop-opacity="0"></stop>
        </linearGradient>
        {/* The rail warms along its length: neutral where raw transactions arrive, brand blue
            through the working stations, accent as it reaches the books. Decorative only —
            `--scene-brand*` are the mark's colours and never state vocabulary. */}
        <linearGradient id="rail-g" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="var(--scene-line)"></stop>
          <stop offset="28%" stop-color="var(--scene-brand-mid)" stop-opacity="0.55"></stop>
          <stop offset="72%" stop-color="var(--scene-brand)" stop-opacity="0.7"></stop>
          <stop offset="100%" stop-color="var(--scene-accent)" stop-opacity="0.85"></stop>
        </linearGradient>
        <linearGradient id="feed-fade-g" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#fff" stop-opacity="1"></stop>
          <stop offset="58%" stop-color="#fff" stop-opacity="1"></stop>
          <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <mask id="feed-fade">
          <rect x="920" y="120" width="560" height="300" fill="url(#feed-fade-g)"></rect>
        </mask>

        {/* Glass, built from gradients rather than `backdrop-filter`, which does not apply to SVG
            shapes. Three layers make the read: a tinted body, a bright rim light along the upper
            left, and a specular highlight offset from centre. */}
        <radialGradient id="orb-sheen" cx="0.34" cy="0.28" r="0.72">
          <stop offset="0%" stop-color="#fff" stop-opacity="0.95"></stop>
          <stop offset="42%" stop-color="#fff" stop-opacity="0.28"></stop>
          <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
        </radialGradient>
        <linearGradient id="orb-rim" x1="0.2" y1="0" x2="0.8" y2="1">
          <stop offset="0%" stop-color="#fff" stop-opacity="0.9"></stop>
          <stop offset="45%" stop-color="#fff" stop-opacity="0.15"></stop>
          <stop offset="100%" stop-color="#fff" stop-opacity="0.55"></stop>
        </linearGradient>
        <filter id="orb-shadow" x="-50%" y="-50%" width="200%" height="200%">
          <feDropShadow dx="0" dy="6" stdDeviation="9" flood-color="#0b1a33" flood-opacity="0.18" />
        </filter>
      </defs>

      <g data-camera>
        {/* ------------------------------------------------- act 1 · the raw feed */}
        {/* Unboxed text, weighted: the four lines that become payments carry full-strength ink and
            the rest sit back, with the amount column right-aligned on a tabular face so the figures
            line up the way they do on a real statement. Masked at the foot so the feed dissolves
            rather than stopping at an edge — a feed continues past the frame; a list ends. */}
        <g data-act="feed" mask="url(#feed-fade)">
          {/* Set in the TEXT face, not the machine one: this is the film speaking, not a value the
              system produced. The live dot is the only thing that says "still arriving". */}
          <text x="960" y="150" font-size="26" font-weight="500" letter-spacing="-0.4" fill="var(--scene-ink)">
            Feed from your bank
          </text>
          <circle cx="1258" cy="142" r="5" fill="var(--scene-ok)" data-live-dot></circle>
          {/* Plaid named rather than orbed: it is the pipe, not an institution the money is at. */}
          <text x="960" y="180" font-size="15" fill="var(--scene-dim)">
            connected through Plaid
          </text>

          {
            FEED.map((line, i) => {
              const y = 208 + i * 41
              return (
                <g data-narr={i} opacity={line.tick ? 1 : 0.45}>
                  <text
                    x="960"
                    y={y}
                    class="mono"
                    font-size="14.5"
                    fill={line.tick ? 'var(--scene-muted)' : 'var(--scene-dim)'}
                  >
                    {line.desc}
                  </text>
                  {/* Amount and narration are both machine artefacts, so both are mono — which is
                      Source Code Pro now (ADR 0012 §13). The `figure` role that briefly set these
                      in the text face is gone with it. */}
                  <text
                    x="1404"
                    y={y}
                    class="mono"
                    font-size="15"
                    text-anchor="end"
                    fill={line.tick ? 'var(--scene-ink)' : 'var(--scene-dim)'}
                  >
                    {line.amt}
                  </text>
                </g>
              )
            })
          }
        </g>

        {/* --------------------------------------------- the institutions it arrives from */}
        {/* Outside the feed's mask on purpose: the mask exists to dissolve the narration lines at
            their foot, and running it over the orbs would fade the bottom half of the field.

            Positions here are the SERVER-RENDERED layout, and they are a complete, deliberate
            arrangement on their own. The physics loop takes over on rAF and overwrites these
            transforms; if it never runs (no JS, reduced motion, off-screen) this is what ships,
            which is the same guarantee the rest of the film makes. */}
        <g data-orbs>
          {
            ORBS.map((o) => (
              <g data-orb={o.id} transform={`translate(${o.x} ${o.y})`}>
                <g filter="url(#orb-shadow)">
                  {/* An opaque base first. Glass over the page's own canvas needs something to
                      refract, and a purely translucent disc just went muddy against it. */}
                  <circle r={o.r} fill="var(--scene-surface)" />
                  <circle r={o.r} fill={o.tint} fill-opacity="0.1" />
                  <circle r={o.r} fill="url(#orb-sheen)" />
                  <circle r={o.r} fill="none" stroke={o.tint} stroke-opacity="0.22" stroke-width="1" />
                  <circle r={o.r} fill="none" stroke="url(#orb-rim)" stroke-width="1.8" />
                </g>

                {/* Simple Icons normalises every mark to a 24x24 box, so one transform serves
                    all four: centre it, then scale to ~62% of the orb's diameter. */}
                <g
                  transform={`translate(${-o.r * 0.62} ${-o.r * 0.62}) scale(${(o.r * 1.24) / 24})`}
                  fill={o.tint}
                >
                  <path d={o.d} />
                </g>

              </g>
            ))
          }
        </g>

        {/* ------------------------------------------------------------- the rail */}
        <rect
          x="1000"
          y={RAIL_Y}
          width="2850"
          height="2"
          fill="url(#rail-g)"
          data-rail></rect>

        {
          STATIONS.map((s, i) => (
            <g data-station={i}>
              <rect x={s.x - 1} y={RAIL_Y - 26} width="2" height="52" fill="var(--scene-line)" />

              {/* THE LIT STATE IS A SECOND, BRAND-COLOURED COPY AT opacity 0 — not a colour tween.
                  Point 2 of this file's header comment is that colour is read from the stylesheet
                  and NEVER tweened, and that rule is why the film has no seams. Fading a stacked
                  copy in and out gets the same "this station is live" reading while leaving every
                  colour a static value the stylesheet owns. */}
              <rect
                x={s.x - 1.5}
                y={RAIL_Y - 30}
                width="3"
                height="60"
                fill="var(--scene-brand-mid)"
                opacity="0"
                data-station-tick={i}
              />
              <text
                x={s.x}
                y={RAIL_Y + 78}
                class="mono"
                font-size="18"
                letter-spacing="3"
                text-anchor="middle"
                fill="var(--scene-dim)"
                data-station-label={i}
              >
                {s.label.toUpperCase()}
              </text>
              <text
                x={s.x}
                y={RAIL_Y + 78}
                class="mono"
                font-size="18"
                letter-spacing="3"
                text-anchor="middle"
                fill="var(--scene-brand)"
                opacity="0"
                data-station-lit={i}
              >
                {s.label.toUpperCase()}
              </text>
            </g>
          ))
        }

        {/* One line above each station — what this part of the pipeline is doing, in the fewest
            words that still say something specific. Set in the text face, not the mono one: this
            is the film talking to the reader, not a value the system produced. */}
        {
          STATIONS.map((st, i) => (
            <text
              x={st.x}
              y="372"
              font-size="40"
              font-weight="500"
              letter-spacing="-0.8"
              text-anchor="middle"
              fill="var(--scene-ink)"
              opacity="0"
              data-stage-caption={i}
            >
              {st.caption}
            </text>
          ))
        }

        {/* The evidence sweep at MATCH. */}
        <rect
          x={STATIONS[1]!.x - 90}
          y={RAIL_Y - 190}
          width="180"
          height="380"
          fill="url(#film-beam)"
          opacity="0"
          data-beam></rect>

        {/* ------------------------------------------------- act 4 · your books */}
        <g data-act="books">
          <text
            x={LEDGER_X}
            y="150"
            class="mono"
            font-size="17"
            letter-spacing="3"
            fill="var(--scene-dim)"
          >
            YOUR BOOKS
          </text>
          {
            ROWS.map((row, i) => (
              <g>
                <text
                  x={LEDGER_X}
                  y={row.y - 14}
                  class="mono"
                  font-size="16"
                  fill="var(--scene-dim)"
                  data-row-label={i}
                >
                  {row.ref}
                </text>
                <rect x={LEDGER_X} y={row.y} width={ROW_W} height="2" fill="var(--scene-line)" />
                <rect
                  x={LEDGER_X}
                  y={row.y}
                  width="0"
                  height="2"
                  fill="var(--scene-ok)"
                  data-row-fill={i}
                />
              </g>
            ))
          }

          {/* The exception tray. */}
          <rect
            x={LEDGER_X}
            y="700"
            width={ROW_W}
            height="96"
            rx="8"
            stroke="var(--scene-warn)"
            stroke-width="1.5"
            stroke-dasharray="5 5"
            opacity="0.55"></rect>
          <text
            x={LEDGER_X + 20}
            y="740"
            class="mono"
            font-size="15"
            letter-spacing="2"
            fill="var(--scene-warn)"
          >
            NEEDS YOU
          </text>
          <text
            x={LEDGER_X + 20}
            y="770"
            class="mono"
            font-size="15"
            fill="var(--scene-warn)"
            opacity="0"
            data-tray-item
          >
            CHECK 8842 · two candidates
          </text>
        </g>

        {/* ---------------------------------------------------- connectors */}
        {/* MATCH to the invoice row a payment was attributed to. The exception draws TWO, then
            retracts both — ambiguity escalates, it is never resolved by picking one. */}
        {
          [
            { id: 'a', row: 0, tone: 'accent' },
            { id: 'b', row: 2, tone: 'accent' },
            { id: 'd', row: 4, tone: 'accent' },
            { id: 'c1', row: 1, tone: 'warn' },
            { id: 'c2', row: 3, tone: 'warn' },
          ].map((c) => (
            <path
              d={`M ${STATIONS[1]!.x} ${RAIL_Y} C ${STATIONS[1]!.x + 700} ${RAIL_Y}, ${LEDGER_X - 640} ${ROWS[c.row]!.y}, ${LEDGER_X} ${ROWS[c.row]!.y}`}
              stroke={c.tone === 'warn' ? 'var(--scene-warn)' : 'var(--scene-accent)'}
              stroke-width="1.5"
              pathLength="1"
              stroke-dasharray="1"
              stroke-dashoffset="1"
              opacity="0.5"
              data-conn={c.id}
            />
          ))
        }

        {/* -------------------------------------------------------------- chips */}
        {
          CHIPS.map((chip) => (
            <g transform={`translate(${chip.x} ${RAIL_Y - 27})`} data-chip={chip.id} opacity="0">
              <g opacity="0" data-tag={chip.id}>
                <rect
                  x="0"
                  y="-44"
                  width="176"
                  height="30"
                  rx="5"
                  fill={chip.row === null ? 'var(--scene-warn)' : 'var(--scene-ok)'}
                  opacity="0.16"
                />
                <text
                  x="14"
                  y="-23"
                  class="mono"
                  font-size="16"
                  fill={chip.row === null ? 'var(--scene-warn)' : 'var(--scene-ok)'}
                >
                  {chip.tag}
                </text>
              </g>
              {/* THE BOX MUST BE WIDER THAN THE TEXT IT HOLDS — it was not. The amount is
                  right-anchored at x=248 and the plate is 268 wide, giving it 20 units of inset.
                  The previous pair (anchor 244, plate 232) put the figure's right edge twelve
                  units OUTSIDE the plate, so every amount hung off the end of its own chip and the
                  rail ran straight through it. Widening the plate rather than pulling the anchor
                  in keeps the ref and the amount from crowding: "INV-1042" ends near x=113 and
                  "$48,500.00" starts near x=146. Chips sit 300 apart, so 268 still leaves a gap. */}
              <rect
                x="0"
                y="0"
                width="268"
                height="54"
                rx="7"
                fill="var(--scene-surface)"
                stroke="var(--scene-line)"
                stroke-width="1.5"
              />
              <rect x="0" y="0" width="4" height="54" rx="2" fill="var(--scene-accent)" data-chip-edge={chip.id} />
              <text x="22" y="34" class="mono" font-size="19" fill="var(--scene-ink)">
                {chip.ref}
              </text>
              <text x="248" y="34" class="mono" font-size="17" text-anchor="end" fill="var(--scene-muted)">
                {chip.amt}
              </text>
            </g>
          ))
        }
      </g>
    </svg>

    {/* ------------------------------------------------------------------ copy */}
    <div class="relative z-10 flex flex-1 items-center pt-[4.5rem]">
      <div class="shell w-full">
        <div data-copy class="max-w-2xl">
          {/* The hero's eyebrow, matching the `label` role everywhere else: Geist rather than the
              machine face, and carrying brand colour. It reads scene variables rather than theme
              tokens because everything inside the stage does — see the header comment, point 2. */}
          <span
            class="mb-4 block h-[3px] w-[3.25rem] rounded-[2px]"
            style="background-image: linear-gradient(90deg, var(--scene-brand), var(--scene-brand-mid) 55%, var(--scene-accent))"
            aria-hidden="true"></span>
          <p
            class="text-xs font-semibold tracking-[0.08em] uppercase"
            style="color: var(--scene-brand-mid)"
          >
            Agentic accounting operations
          </p>
          <h1
            class="mt-6 text-[clamp(2.0625rem,4.15vw,3.6rem)] leading-[1.05] font-medium text-balance"
            style="color: var(--scene-ink)"
          >
            Your bank feed, reconciled and posted. While you’re doing something else.
          </h1>
          <p
            class="mt-7 max-w-xl text-lg leading-relaxed"
            style="color: var(--scene-muted)"
          >
            Verity connects your bank and your billing system, works out what each payment was,
            credits what is owed, and posts it back. Your finance head reads a summary at the end of
            the day instead of doing the work during it.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-3">
            <CtaButton
              class="rounded-sm inline-flex items-center gap-2 px-5 py-3.5 text-base font-medium"
              style="background: var(--scene-ink); color: var(--scene-bg)"
              arrow
            />
            <a
              href={url("/how-it-works")}
              class="rounded-sm inline-flex border px-5 py-3 text-sm transition-colors"
              style="border-color: var(--scene-line); color: var(--scene-muted)"
            >
              How it works
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const section = document.querySelector<HTMLElement>('[data-film]')
  const stage = document.querySelector<HTMLElement>('[data-stage]')
  const scene = document.querySelector<SVGSVGElement>('[data-scene]')
  const camera = document.querySelector<SVGGElement>('[data-camera]')

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
  const wideEnough = window.matchMedia('(min-width: 900px) and (min-aspect-ratio: 8/5)')

  /**
   * THE GATE IS RE-EVALUATED, NOT DECIDED ONCE AT LOAD.
   *
   * Both conditions can change during a visit: a window dragged wider or maximised, a tablet
   * rotated, or reduced-motion toggled in the OS. Reading `matchMedia` once meant a reader who
   * loaded in a narrow window and then maximised was left with the static hero for the rest of
   * the session, with no way to discover the film but a reload. Both transitions are handled.
   */
  const haveElements = Boolean(section && stage && scene && camera)
  let film: gsap.core.Timeline | null = null

  /** Act one, as an ordinary hero — the no-JS, too-narrow and reduced-motion case. */
  const showStatic = () => {
    if (!haveElements) return
    stage!.style.height = 'auto'
    stage!.classList.remove('sticky', 'top-0')
    stage!.classList.add('py-24')
    section!.style.height = ''
    gsap.set(camera, { x: 0 })
    gsap.set('[data-copy]', { clearProps: 'all' })
    gsap.set('[data-chip]', { opacity: 1, x: 0, y: 0, scale: 1 })
    gsap.set('[data-narr]', { clearProps: 'opacity' })
    gsap.set('[data-stage-caption]', { opacity: 0 })
    gsap.set('[data-conn]', { attr: { 'stroke-dashoffset': 1 } })
    gsap.set('[data-row-fill]', { attr: { width: 0 } })
    gsap.set(
      ['[data-tag]', '[data-tray-item]', '[data-beam]', '[data-station-lit]', '[data-station-tick]'],
      { opacity: 0 },
    )
  }

  /** Tears the film down if one is running. Restoring the static hero is `showStatic`'s job, so
   *  that the "never started" and "was running" paths converge on exactly the same end state. */
  const stopFilm = () => {
    if (!film) return
    film.scrollTrigger?.kill()
    film.kill()
    film = null
  }

  const startFilm = () => {
    if (film || !haveElements) return
    stage!.classList.remove('py-24')
    // The tall scroll height is applied HERE, never in CSS — see the header comment, point 1.
    section!.style.height = '460vh'
    stage!.classList.add('sticky', 'top-0')
    stage!.style.height = '100svh'

    const copy = document.querySelector<HTMLElement>('[data-copy]')
    const q = <T extends Element>(sel: string) => scene!.querySelector<T>(sel)

    /** How far the camera may travel: scene width minus whatever the viewport actually shows. */
    const panEnd = () => {
      const shown = 900 * (stage!.clientWidth / stage!.clientHeight)
      return Math.min(0, -(4200 - shown))
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section!,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.8,
        // panEnd() is a function value, so it must be re-evaluated on refresh — otherwise a
        // resize (or a rotated tablet) keeps panning to the old viewport's distance and either
        // overshoots past the scene's edge or stops short of the ledger.
        invalidateOnRefresh: true,
      },
    })

    // The camera. Everything else is timed against this pan, so a beat always fires while its
    // station is actually on screen.
    tl.to(camera, { x: panEnd, ease: 'none', duration: 10 }, 0)

    /**
     * THE BEATS ARE TIMED AGAINST THE CAMERA, NOT PICKED BY FEEL.
     *
     * The pan is linear over 10 units across `panEnd` (~2760 scene units), so a station sits in
     * the middle of frame at `(stationX - 720) / 2760 * 10`. The first cut of this timeline was
     * tuned by eye and fired the match beam at t=2.6 — when the camera was still showing
     * 718–2158 and MATCH (x=2280) had not yet come on screen. The beat played to nobody. Every
     * beat below is anchored to the moment its subject is actually visible.
     *
     *   INGEST 1780 → 3.84    MATCH 2280 → 5.65    CLASSIFY 2800 → 7.54    POST 3300 → 9.35
     *   the ledger (x 3560–3880) enters frame at 8.84
     */
    const ROWS_Y = [210, 268, 326, 384, 442]
    const chips = [
      { id: 'a', row: 0, to: 3300 },
      { id: 'b', row: 2, to: 3020 },
      { id: 'c', row: null, to: 2740 },
      { id: 'd', row: 4, to: 2460 },
    ]

    // Act 1 → 2: the copy hands over to the film, and the feed resolves into payments.
    tl.to(copy, { opacity: 0, y: -30, duration: 0.8 }, 0.6)
    tl.to('[data-narr]', { opacity: 0.22, duration: 1, stagger: { amount: 0.8 } }, 1.0)
    tl.to('[data-chip]', { opacity: 1, duration: 0.6, stagger: 0.18 }, 1.3)

    /** A caption owns the frame only while its station does — and the station lights with it, so
     *  the colour and the words arrive as one event rather than two. */
    const caption = (i: number, at: number, until: number) => {
      tl.fromTo(
        `[data-stage-caption="${i}"]`,
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.7 },
        at,
      )
      tl.to(`[data-stage-caption="${i}"]`, { opacity: 0, y: -14, duration: 0.6 }, until)

      // The lit label crossfades over the dim one; the tick grows from the rail rather than
      // appearing. Both are opacity/scale only — no colour is tweened (header comment, point 2).
      tl.to(`[data-station-lit="${i}"]`, { opacity: 1, duration: 0.5 }, at)
      tl.fromTo(
        `[data-station-tick="${i}"]`,
        { opacity: 0, scaleY: 0.2, transformOrigin: 'center' },
        { opacity: 1, scaleY: 1, duration: 0.6 },
        at,
      )
      tl.to([`[data-station-lit="${i}"]`, `[data-station-tick="${i}"]`], { opacity: 0, duration: 0.5 }, until)
    }

    // The payments travel the rail while the camera travels with them — slightly slower, so they
    // drift back through the frame instead of sitting nailed to one spot.
    chips.forEach((c) => {
      tl.to(`[data-chip="${c.id}"]`, { x: c.to, ease: 'none', duration: 5.4 }, 3.2)
    })

    caption(0, 3.2, 4.9) // INGEST
    caption(1, 5.1, 6.9) // MATCH

    // MATCH: the evidence sweep, then the connections it justifies.
    tl.fromTo('[data-beam]', { opacity: 0, x: -130 }, { opacity: 1, x: 130, duration: 1.2 }, 5.1)
    tl.to('[data-beam]', { opacity: 0, duration: 0.4 }, 6.1)
    tl.to(['[data-conn="a"]', '[data-conn="b"]', '[data-conn="d"]'], {
      attr: { 'stroke-dashoffset': 0 },
      duration: 1.1,
      stagger: 0.2,
    }, 5.7)

    // The exception: two candidates drawn, then retracted. Ambiguity escalates; it is never
    // resolved by picking one.
    tl.to(['[data-conn="c1"]', '[data-conn="c2"]'], {
      attr: { 'stroke-dashoffset': 0 },
      duration: 0.9,
      stagger: 0.12,
    }, 6.2)
    tl.to(['[data-conn="c1"]', '[data-conn="c2"]'], {
      attr: { 'stroke-dashoffset': 1 },
      duration: 0.8,
    }, 7.6)

    // CLASSIFY.
    caption(2, 7.1, 8.7)
    tl.to('[data-tag]', { opacity: 1, duration: 0.5, stagger: 0.16 }, 7.3)
    tl.to('[data-chip-edge="c"]', { attr: { fill: 'var(--scene-warn)' }, duration: 0.3 }, 7.7)

    // POST — held until 8.9, when the ledger is genuinely in frame.
    caption(3, 8.8, 9.9)
    chips.forEach((c, i) => {
      if (c.row === null) return
      const at = 8.95 + i * 0.14
      tl.to(`[data-chip="${c.id}"]`, { x: 3560, y: ROWS_Y[c.row]! - 27, scale: 0.8, opacity: 0, duration: 0.9 }, at)
      tl.to(`[data-row-fill="${c.row}"]`, { attr: { width: 320 }, duration: 0.7 }, at + 0.3)
    })

    // The exception lands in the tray instead.
    tl.to('[data-chip="c"]', { x: 3560, y: 712, scale: 0.8, opacity: 0, duration: 0.9 }, 9.2)
    tl.to('[data-tray-item]', { opacity: 1, duration: 0.5 }, 9.6)

    ScrollTrigger.addEventListener('refreshInit', () => gsap.set(camera, { x: 0 }))

    film = tl
    if (import.meta.env.DEV) {
      ;(window as unknown as { __film?: gsap.core.Timeline }).__film = tl
    }
  }

  /**
   * The orb field's physics: zero-gravity drift, walls, and elastic orb-on-orb collision.
   *
   * HAND-ROLLED RATHER THAN A LIBRARY, for one reason worth stating: the homepage already ships
   * 113KB for GSAP, and matter.js would roughly double that to animate five circles. Circle
   * physics is about forty lines. The dependency is not worth its weight here.
   *
   * It runs on its own rAF clock, deliberately NOT on the scroll timeline. The film is scrubbed —
   * it only moves when the reader moves — and orbs that froze whenever the reader stopped
   * scrolling would read as broken rather than as floating. Two independent systems writing two
   * different transforms: GSAP owns the camera, this owns each orb.
   */
  /**
   * Tuned against a headless run of this exact loop (90 simulated seconds per config), checking
   * four things: no NaN, nothing escaping the box, no sustained overlap, and speeds that stay
   * VARIED rather than collapsing to one value.
   *
   * The scene is 4200 units wide rendered at roughly 1440px, so one scene unit is about a third
   * of a screen pixel. These values were measured over 120 simulated seconds across six bodies:
   * about 3 px/sec on average and 7 px/sec at peak. That is deliberately slight. An earlier pass
   * ran roughly three times faster and read as busy behind the headline, which is the opposite of
   * what a hero should do.
   */
  const WANDER = 1
  const MAX_SPEED = 40

  let orbFrame = 0
  const startOrbs = () => {
    if (orbFrame) return
    const nodes = [...document.querySelectorAll<SVGGElement>('[data-orb]')]
    if (!nodes.length) return

    // Scene-coordinate bounds of act one's field, matching the server-rendered layout above and
    // sitting clear of the narration lines, which end around y=340.
    const BOX = { x0: 975, y0: 372, x1: 1455, y1: 604 }
    const bodies = nodes.map((el) => {
      const m = /translate\(([-\d.]+) ([-\d.]+)\)/.exec(el.getAttribute('transform') || '')
      const r = Number(el.querySelector('circle')?.getAttribute('r') ?? 45)
      return {
        el,
        x: m ? Number(m[1]) : 1200,
        y: m ? Number(m[2]) : 400,
        // Seeded per-orb so the field never starts in lockstep.
        vx: (Math.random() - 0.5) * 34,
        vy: (Math.random() - 0.5) * 34,
        r,
        m: r * r,
      }
    })

    let last = performance.now()
    const step = (now: number) => {
      // Clamped, so a backgrounded tab returning after a minute does not integrate one huge
      // timestep and fling every orb through a wall.
      const dt = Math.min((now - last) / 1000, 0.05)
      last = now

      for (const b of bodies) {
        // A small random nudge every frame. This is what makes the field read as FLOATING rather
        // than as four balls on a billiard table: without it, drag bleeds the system down until
        // every orb sits at exactly the same speed, which a headless run of this loop showed
        // converging to a dead-uniform 8.0 units/sec within a minute. Four identical drifts look
        // mechanical. The wander keeps their energies apart indefinitely.
        b.vx += (Math.random() - 0.5) * WANDER
        b.vy += (Math.random() - 0.5) * WANDER

        b.x += b.vx * dt
        b.y += b.vy * dt

        // Walls. Reflect and damp slightly, then clamp so a body can never rest outside.
        if (b.x - b.r < BOX.x0) { b.x = BOX.x0 + b.r; b.vx = Math.abs(b.vx) * 0.9 }
        if (b.x + b.r > BOX.x1) { b.x = BOX.x1 - b.r; b.vx = -Math.abs(b.vx) * 0.9 }
        if (b.y - b.r < BOX.y0) { b.y = BOX.y0 + b.r; b.vy = Math.abs(b.vy) * 0.9 }
        if (b.y + b.r > BOX.y1) { b.y = BOX.y1 - b.r; b.vy = -Math.abs(b.vy) * 0.9 }
      }

      // Elastic collision, equal-mass form weighted by area. Only 5 bodies, so the naive O(n²)
      // pass is cheaper than any structure that would avoid it.
      for (let i = 0; i < bodies.length; i++) {
        for (let j = i + 1; j < bodies.length; j++) {
          const a = bodies[i]!, c = bodies[j]!
          const dx = c.x - a.x, dy = c.y - a.y
          const d = Math.hypot(dx, dy) || 0.0001
          const overlap = a.r + c.r - d
          if (overlap <= 0) continue

          const nx = dx / d, ny = dy / d
          // Positional correction first, split by mass, so they never sink into each other.
          const total = a.m + c.m
          a.x -= nx * overlap * (c.m / total); a.y -= ny * overlap * (c.m / total)
          c.x += nx * overlap * (a.m / total); c.y += ny * overlap * (a.m / total)

          const rel = (c.vx - a.vx) * nx + (c.vy - a.vy) * ny
          if (rel > 0) continue // already separating
          const imp = (-1.85 * rel) / (1 / a.m + 1 / c.m)
          a.vx -= (imp * nx) / a.m; a.vy -= (imp * ny) / a.m
          c.vx += (imp * nx) / c.m; c.vy += (imp * ny) / c.m
        }
      }

      // Drag, plus a ceiling. There is deliberately NO speed floor: a hard floor is what produced
      // the uniform-speed failure above. The wander force is the thing that keeps them alive.
      for (const b of bodies) {
        b.vx *= 0.999; b.vy *= 0.999
        const sp = Math.hypot(b.vx, b.vy)
        if (sp > MAX_SPEED) { const k = MAX_SPEED / sp; b.vx *= k; b.vy *= k }
        b.el.setAttribute('transform', `translate(${b.x.toFixed(2)} ${b.y.toFixed(2)})`)
      }

      orbFrame = requestAnimationFrame(step)
    }
    orbFrame = requestAnimationFrame(step)
  }

  const stopOrbs = () => {
    if (!orbFrame) return
    cancelAnimationFrame(orbFrame)
    orbFrame = 0
  }

  // Nothing to compute while the hero is off-screen or the tab is hidden (ADR 0012 §7.3).
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopOrbs()
    else if (wideEnough.matches && !reduced.matches) startOrbs()
  })

  const evaluate = () => {
    if (!haveElements) return

    // THE ORBS ARE GATED SEPARATELY FROM THE FILM, and the distinction is the point. The film
    // needs width because it pins a stage and pans a scene three viewports wide; below 900px that
    // cannot work, so it degrades to a static hero. Five circles drifting in a box have no such
    // constraint. Starting them inside `startFilm` made them inherit a limit that was never about
    // them, and act one lost its motion on exactly the screens with the least else going on.
    if (reduced.matches || document.hidden) stopOrbs()
    else startOrbs()

    if (wideEnough.matches && !reduced.matches) {
      startFilm()
    } else {
      stopFilm()
      showStatic()
    }
  }

  evaluate()
  wideEnough.addEventListener('change', evaluate)
  reduced.addEventListener('change', evaluate)
</script>
