---
/**
 * Home — the whole argument in one scroll, per the narrative's §7.4 section plan.
 *
 * Copy is derived from docs/marketing/product-narrative.md and nothing here asserts anything that
 * document does not. Two tense rules are load-bearing: the autonomous lane is LIVE and written in
 * the present tense; removing the approval step for bank-matched payments is NEXT and is written
 * as shipping next, never as done.
 */
import CtaButton from '@/components/CtaButton.astro'
import ScrollFilm from '@/components/hero/ScrollFilm.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { CONTACT_EMAIL } from '@/consts'

const pipeline = [
  {
    n: '01',
    title: 'Ingest',
    body: 'Verity polls your bank feed every few minutes, resuming from where it left off rather than re-sweeping history. A retried poll or a restart mid-batch produces no duplicate rows.',
  },
  {
    n: '02',
    title: 'Match',
    body: 'Each payment is matched to the invoice it belongs to — on confirmed evidence, or not at all. Zero candidates, or more than one, is an exception rather than a guess.',
  },
  {
    n: '03',
    title: 'Classify',
    body: 'Duplicate, overpayment, normal payment, or unmatchable. Duplicate detection reads Verity’s own confirmed history, never your billing system’s opaque “paid” flag.',
  },
  {
    n: '04',
    title: 'Act',
    body: 'A credit note where one is owed; a reconciliation where none is. The decision is recorded as an automated decision, in its own record, labelled as automation.',
  },
  {
    n: '05',
    title: 'Post',
    body: 'The correction is written back to your billing system through a recoverable queue. A write that fails — or succeeds with the acknowledgement lost — is retried without risking a second posting.',
  },
  {
    n: '06',
    title: 'Report',
    body: 'At end of day: what the pipeline did, and what still needs you. The two lists cannot overlap — an item is settled or waiting, never presented as both.',
  },
]

const classifications = [
  { type: 'normal_payment', means: 'Settles the invoice it names', does: 'Reconciled. No credit.', tone: 'confirmed' },
  { type: 'duplicate', means: 'The invoice was already settled', does: 'Credit note for the full amount', tone: 'confirmed' },
  { type: 'overpayment', means: 'More than the invoice was for', does: 'Credit note for the excess', tone: 'confirmed' },
  { type: 'unmatchable', means: 'The evidence does not settle it', does: 'Routed to a person, with the reasoning', tone: 'exception' },
]

const connectors = [
  { name: 'Plaid', role: 'Bank feed', status: 'Available' },
  { name: 'Zoho Books', role: 'Billing system', status: 'Available' },
  { name: 'QuickBooks Online', role: 'Billing system', status: 'Adapter in progress' },
  { name: 'Xero', role: 'Billing system', status: 'Adapter in progress' },
  { name: 'Odoo', role: 'Billing system', status: 'Needs encrypted credential storage' },
  { name: 'TallyPrime', role: 'Billing system', status: 'Needs a local connector' },
]
---

<BaseLayout title="Your bank feed, reconciled and posted">
  {/* The hero is the film: a pinned, scroll-scrubbed pass through the whole pipeline, on the
      page's own light canvas throughout, so it hands off into the content below with no seam.
      It carries its own h1, subhead and CTAs. */}
  <ScrollFilm />

  {/* The connector strip sits immediately under the film, in the light, as the first thing the
      resolved palette touches. */}
  <div class="shell">
    <div class="border-hairline text-ink-subtle flex flex-wrap gap-x-8 gap-y-2 border-b pb-6 text-xs">
      <span class="mono">Plaid</span>
      <span class="mono">Zoho Books</span>
      <span class="mono">QuickBooks · in progress</span>
      <span class="mono">Xero · in progress</span>
      <span class="mono">Odoo · planned</span>
      <span class="mono">TallyPrime · planned</span>
    </div>
  </div>

  {/* ------------------------------------------------------------- problem */}
  <section class="section-y">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="label">The loop</p>
          <h2 class="reveal mt-4 text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            The work we take off your desk.
          </h2>
        </div>
        <div class="reveal text-ink-muted max-w-2xl space-y-5 text-lg leading-relaxed">
          <p>
            A payment lands. Somebody — usually the most senior person who understands the customer —
            opens the bank statement, then the accounting system, and starts matching.
          </p>
          <p>
            The reference is missing or truncated. The amount is two invoices paid together, or a
            part payment. It’s the second payment against an invoice settled last month, and nobody
            will notice until the customer complains.
          </p>
          <p class="text-ink">
            None of it is hard. All of it needs context. And it stays invisible until it compounds
            into a slow close, an angry customer, or a number nobody can explain.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ pipeline */}
  <section class="rule-top section-y">
    <div class="shell">
      <p class="label">The pipeline</p>
      <h2 class="mt-4 max-w-3xl text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
        What happens between a payment landing and your books being right.
      </h2>

      <ol class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        {
          pipeline.map((step) => (
            <li class="reveal">
              <div class="bg-hairline rule-draw h-px w-full" />
              <p class="mono text-accent mt-5 text-xs">{step.n}</p>
              <h3 class="mt-2 text-xl font-medium">{step.title}</h3>
              <p class="text-ink-muted mt-2.5 leading-relaxed">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------------------------------------------------- attribution floor */}
  <section class="rule-top section-y">
    <div class="shell">
      <div class="grid gap-14 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="label">The matching floor</p>
          <h2 class="mt-4 text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            It acts on proof, not on a good guess.
          </h2>
          <div class="text-ink-muted mt-7 space-y-5 text-lg leading-relaxed">
            <p>
              Bank narration is hostile to machines. A reference number sitting in a payment
              description is a hint — and automating on hints is how wrong entries reach real books.
            </p>
            <p class="text-ink font-medium">
              So the model advises; it never authorizes.
            </p>
            <p>
              A language model reads the messy narration and proposes a candidate. That proposal
              cannot be what causes money to move. Only an attribution-grade reference — one the
              payment itself carries, confirmed against the invoice it names — clears the floor.
              Everything above it is handled end to end. Everything below it becomes an exception,
              with the model’s reading attached as context.
            </p>
          </div>
        </div>

        <div class="border-hairline bg-surface rounded-lg border p-6 sm:p-8">
          <p class="label">Classification</p>
          <ul class="mt-6 space-y-6">
            {
              classifications.map((c) => (
                <li class="border-hairline grid gap-2 border-b pb-6 last:border-0 last:pb-0 sm:grid-cols-[auto_1fr] sm:gap-5">
                  <span class:list={['chip', c.tone === 'confirmed' ? 'chip-confirmed' : 'chip-exception']}>
                    {c.type}
                  </span>
                  <div>
                    <p class="text-sm">{c.means}</p>
                    <p class="text-ink-muted mt-1 text-sm">{c.does}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- the day */}
  <section class="rule-top section-y">
    <div class="shell">
      <div class="grid gap-14 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="label">Oversight</p>
          <h2 class="mt-4 text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            Your 5:30pm, not your 9am.
          </h2>
          <div class="text-ink-muted mt-7 space-y-5 text-lg leading-relaxed">
            <p>
              The end-of-day report is two lists that cannot overlap: everything the pipeline
              settled today, each with the basis for its decision — and the short list of items whose
              evidence didn’t settle, waiting for you.
            </p>
            <p>
              Because every action is stamped at write time with what kind of actor took it, Verity
              can answer a question most finance tools cannot: what fraction of your money decisions
              had no human in the loop. Automation is never recorded as a human approval, so “the
              system did this automatically” is a defensible audit answer rather than an awkward
              discovery.
            </p>
          </div>
        </div>

        <div class="border-hairline bg-surface rounded-lg border p-6 sm:p-8">
          <p class="label">Shipping next</p>
          <p class="mt-4 leading-relaxed">
            Removing the approval step for bank-matched payments. Where attribution is confirmed, the
            pipeline classifies, credits and posts with no pre-write human gate.
          </p>
          <p class="text-ink-muted mt-4 text-sm leading-relaxed">
            The controls that make that safe stay exactly where they are: the matching floor,
            idempotent writes, a recoverable posting queue, honest audit, and an exception route for
            anything ambiguous. Discretionary credits — goodwill, negotiated adjustments — keep a
            human decision, because there the evidence is a commercial judgement rather than a fact
            about a payment.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- connectors */}
  <section class="rule-top section-y">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="label">Connects to</p>
          <h2 class="mt-4 max-w-2xl text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            A short, honest list.
          </h2>
        </div>
        <p class="text-ink-muted max-w-md text-sm leading-relaxed">
          A connector is listed as available only when it can carry you end to end. The rest say
          what’s missing. We’d rather show you this than a logo grid that connects to nothing.
        </p>
      </div>

      <ul class="mt-12 grid gap-px overflow-hidden sm:grid-cols-2 lg:grid-cols-3">
        {
          connectors.map((c) => (
            <li class="border-hairline bg-surface -mt-px -ml-px border p-6">
              <div class="flex items-center justify-between gap-4">
                <h3 class="font-medium">{c.name}</h3>
                <span
                  class:list={['chip', c.status === 'Available' ? 'chip-confirmed' : 'chip-neutral']}
                >
                  {c.status === 'Available' ? 'available' : 'coming'}
                </span>
              </div>
              <p class="text-ink-subtle mono mt-3 text-xs">{c.role}</p>
              {c.status !== 'Available' && (
                <p class="text-ink-muted mt-2 text-sm">{c.status}</p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------------- close */}
  <section class="rule-top section-y">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="label">Who it’s for</p>
          <h2 class="mt-4 text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            Finance teams where one person is the bottleneck.
          </h2>
          <p class="text-ink-muted mt-6 max-w-lg text-lg leading-relaxed">
            B2B, invoiced rather than card-paid, enough payment volume that reconciliation is a
            weekly grind, and a finance head personally doing work they shouldn’t be — because
            there’s nobody to hand it to.
          </p>
        </div>

        <div class="border-hairline bg-surface rounded-lg border p-8">
          <p class="label">Design partners</p>
          <p class="mt-4 text-lg leading-relaxed">
            We’re pre-launch and onboarding design partners now.
          </p>
          <ul class="text-ink-muted mt-5 space-y-2.5 text-sm">
            <li>— Direct access to the people building it; your exception patterns shape the matcher.</li>
            <li>— Your accounting system moves up the connector roadmap.</li>
            <li>— Pricing locked for the partnership period.</li>
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <CtaButton
              class="bg-ink text-canvas rounded-sm hover:bg-accent inline-flex px-5 py-3 text-sm font-medium transition-colors duration-200"
            />
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="border-hairline-strong rounded-sm hover:border-ink px-5 py-3 text-sm transition-colors duration-200"
            >
              Talk to us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
