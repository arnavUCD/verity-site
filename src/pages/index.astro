---
/**
 * Home — the whole argument in one scroll, per the narrative's section plan.
 *
 * Copy is derived from docs/marketing/product-narrative.md and nothing here asserts anything that
 * document does not. Two tense rules are load-bearing: the autonomous lane is LIVE and written in
 * the present tense; removing the approval step for bank-matched payments is NEXT and is written
 * as shipping next, never as done.
 */
import CtaButton from '@/components/CtaButton.astro'
import ScrollFilm from '@/components/hero/ScrollFilm.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { CONTACT_EMAIL } from '@/consts'
import { url } from '@/lib/url'
import ResolveText from '@/components/ResolveText.astro'
import IntroOverlay from '@/components/IntroOverlay.astro'

const pipeline = [
  {
    n: '01',
    title: 'Ingest',
    body: 'Verity reads your bank feed every few minutes. It picks up where it left off instead of re-sweeping history, so a retry or a restart mid-batch never doubles a transaction.',
  },
  {
    n: '02',
    title: 'Match',
    body: 'Every payment is matched to the invoice it belongs to, on confirmed evidence or not at all. No candidate is a guess. Nothing gets attributed on a hunch.',
  },
  {
    n: '03',
    title: 'Classify',
    body: 'Duplicate, overpayment, normal payment, or unmatchable. Duplicate detection reads what Verity has confirmed itself. It never trusts your billing system’s “paid” flag, which can mean a dozen things.',
  },
  {
    n: '04',
    title: 'Act',
    body: 'A credit note where one is owed. A reconciliation where none is. The decision is written to its own record and labelled as automation, so no report can dress it up as a human approval.',
  },
  {
    n: '05',
    title: 'Post',
    body: 'The correction goes back to your billing system through a recoverable queue. A write that fails gets retried. So does one that succeeded while the acknowledgement went missing, without posting twice.',
  },
  {
    n: '06',
    title: 'Report',
    body: 'At end of day you get two lists: what Verity settled, and what still needs you. They cannot overlap. An item is done or it is waiting, never both.',
  },
]

const connectors = [
  { name: 'Plaid', role: 'Bank feed', status: 'Available' },
  { name: 'Zoho Books', role: 'Billing system', status: 'Available' },
  { name: 'QuickBooks Online', role: 'Billing system', status: 'Adapter in progress' },
  { name: 'Xero', role: 'Billing system', status: 'Adapter in progress' },
  { name: 'Odoo', role: 'Billing system', status: 'Needs encrypted credential storage' },
  { name: 'TallyPrime', role: 'Billing system', status: 'Needs a local connector' },
]
---

<BaseLayout title="Your bank feed, reconciled and posted">
  {/* The front door — added entirely by script, so its absence (no JS, reduced motion, a visitor
      landing on a #section, a second visit this session) leaves exactly the page below, with
      nothing missing and nothing to wait for. See the component for the full reasoning. */}
  <IntroOverlay />

  {/* The hero is the film: a pinned, scroll-scrubbed pass through the whole pipeline, on the
      page's own light canvas throughout, so it hands off into the content below with no seam.
      It carries its own h1, subhead and CTAs. */}
  <ScrollFilm />

  {/* ------------------------------------------------------------- problem */}
  <section class="section-y">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <span class="accent-bar mb-4" aria-hidden="true"></span>
          <p class="label">The loop</p>
          <h2 class="reveal mt-4 text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            The work we take off your desk.
          </h2>
        </div>
        {/* The read-along: these three paragraphs ink themselves in as you scroll them. It goes
            HERE, on the problem, because this is the passage a finance reader is meant to recognise
            their own week in — and pacing it slows them down enough to. */}
        <div class="max-w-2xl space-y-5 text-lg leading-relaxed">
          <ResolveText text="A payment lands. Someone opens the bank statement, then the accounting system, and starts matching. Usually it is the most senior person who understands the customer." />
          <ResolveText text="The reference is missing. The amount covers two invoices at once, or only part of one. It is the second payment on an invoice you settled last month, and nobody catches it until the customer calls." />
          <ResolveText class="font-medium" text="None of it is hard. All of it needs context. And it stays invisible until it turns into a slow close, an angry customer, or a number nobody can explain." />
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ pipeline */}
  <section class="rule-top section-y field">
    <div class="shell">
      <span class="accent-bar mb-4" aria-hidden="true"></span>
          <p class="label">The pipeline</p>
      <h2 class="mt-4 max-w-3xl text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
        What happens between a payment landing and your books being right.
      </h2>

      <ol class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        {
          pipeline.map((step, i) => (
            <li class="reveal-i" style={`--i: ${i % 3}`}>
              <div class="rule-brand h-px w-full" />
              <p class="mono accent-resolve mt-5 text-xs">{step.n}</p>
              <h3 class="mt-2 text-xl font-medium">{step.title}</h3>
              <p class="text-ink-muted mt-2.5 leading-relaxed">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------------------------------------------------- attribution floor */}
  <section class="rule-top section-y">
    <div class="shell">
      <div class="grid gap-14 lg:grid-cols-[1fr_1fr]">
        <div>
          <span class="accent-bar mb-4" aria-hidden="true"></span>
          <p class="label">The matching floor</p>
          <h2 class="mt-4 text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            It acts on proof, not on a good guess.
          </h2>
          <div class="text-ink-muted mt-7 space-y-5 text-lg leading-relaxed">
            <p>
              Bank narration is hostile to machines. A reference number sitting in a payment
              description is a hint. Automating on hints is how wrong entries reach real books.
            </p>
            <p class="text-ink font-medium">
              So the model advises; it never authorizes.
            </p>
            <p>
              A language model reads the messy narration and proposes a candidate. That proposal
              can never be what moves money. Only a reference the payment itself carries, confirmed
              against the invoice it names, clears the floor. Everything above the floor is handled
              end to end. Everything below it becomes an exception, with the model’s reading
              attached as context.
            </p>
          </div>
        </div>

        <div class="border-hairline bg-surface rounded-lg lift self-start border p-6 sm:p-8">
          <span class="accent-bar mb-4" aria-hidden="true"></span>
          <p class="label">The floor, in one line</p>
          <p class="mt-4 text-lg leading-relaxed">
            A reference the payment itself carries, confirmed against the invoice it names.
          </p>
          <p class="text-ink-muted mt-4 leading-relaxed">
            Clear the floor and Verity handles it end to end. Fall short and it becomes an
            exception. The model’s reading rides along as context, never as authority.
          </p>
          <a
            href={url('/how-it-works#matching-floor')}
            class="text-accent hover:text-brand mt-6 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
          >
            The four classifications, in full
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- the day */}
  <section class="rule-top section-y field-alt">
    <div class="shell">
      <div class="grid gap-14 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <span class="accent-bar mb-4" aria-hidden="true"></span>
          <p class="label">Oversight</p>
          <h2 class="mt-4 text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            Your 5:30pm, not your 9am.
          </h2>
          <div class="text-ink-muted mt-7 space-y-5 text-lg leading-relaxed">
            <p>
              The end-of-day report is two lists that cannot overlap. Everything Verity settled
              today, each with the basis for its decision. And the short list whose evidence did not
              settle, waiting for you.
            </p>
            <p>
              Every action is stamped at write time with the kind of actor that took it. Automation
              is never recorded as a human approval. That means Verity can tell you what share of
              your money decisions had no human in the loop at all, which most finance tools cannot
              answer.
            </p>
          </div>
        </div>

        <div class="border-hairline bg-surface rounded-lg lift border p-6 sm:p-8">
          <span class="accent-bar mb-4" aria-hidden="true"></span>
          <p class="label">Shipping next</p>
          <p class="mt-4 leading-relaxed">
            Removing the approval step for bank-matched payments. Where attribution is confirmed, the
            pipeline classifies, credits and posts with no pre-write human gate.
          </p>
          <a
            href={url('/how-it-works#oversight')}
            class="text-accent hover:text-brand mt-5 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
          >
            Why removing it is safe
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- connectors */}
  <section class="rule-top section-y">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <span class="accent-bar mb-4" aria-hidden="true"></span>
          <p class="label">Connects to</p>
          <h2 class="mt-4 max-w-2xl text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            A short, honest list.
          </h2>
        </div>
        <p class="text-ink-muted max-w-md text-sm leading-relaxed">
          A connector is listed as available only when it carries you end to end. The rest say what
          is missing. We would rather show you this than a logo grid that connects to nothing.
        </p>
      </div>

      <ul class="mt-12 grid gap-px overflow-hidden sm:grid-cols-2 lg:grid-cols-3">
        {
          connectors.map((c, i) => (
            <li
              class="border-hairline bg-surface reveal-i lift -mt-px -ml-px border p-6"
              style={`--i: ${i % 3}`}
            >
              <div class="flex items-center justify-between gap-4">
                <h3 class="font-medium">{c.name}</h3>
                <span
                  class:list={['chip', c.status === 'Available' ? 'chip-confirmed' : 'chip-neutral']}
                >
                  {c.status === 'Available' ? 'available' : 'coming'}
                </span>
              </div>
              <p class="text-ink-subtle mt-3 text-xs">{c.role}</p>
              {c.status !== 'Available' && (
                <p class="text-ink-muted mt-2 text-sm">{c.status}</p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------------- close */}
  <section class="rule-top section-y field">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr]">
        <div>
          <span class="accent-bar mb-4" aria-hidden="true"></span>
          <p class="label">Who it’s for</p>
          <h2 class="mt-4 text-[clamp(1.9rem,3.4vw,2.75rem)] leading-[1.1] font-medium">
            Finance teams where one person is the bottleneck.
          </h2>
          <p class="text-ink-muted mt-6 max-w-lg text-lg leading-relaxed">
            You invoice your customers instead of charging cards. Enough payments arrive that
            reconciliation is a weekly grind. And your finance head is doing the matching
            personally, because there is nobody to hand it to.
          </p>
        </div>

        <div class="border-hairline bg-surface rounded-lg lift border p-8">
          <span class="accent-bar mb-4" aria-hidden="true"></span>
          <p class="label">Design partners</p>
          <p class="mt-4 text-lg leading-relaxed">
            We’re pre-launch and onboarding design partners now.
          </p>
          <ul class="text-ink-muted mt-5 space-y-2.5 text-sm">
            <li>Direct access to the people building it. Your exception patterns shape the matcher.</li>
            <li>Your accounting system moves up the connector roadmap.</li>
            <li>Pricing locked for the partnership period.</li>
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <CtaButton
              class="bg-ink text-canvas rounded-sm hover:bg-accent inline-flex px-5 py-3 text-sm font-medium transition-colors duration-200"
            />
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="border-hairline-strong rounded-sm hover:border-ink px-5 py-3 text-sm transition-colors duration-200"
            >
              Talk to us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
